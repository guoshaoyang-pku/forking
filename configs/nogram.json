{
  "name": "no-gram control",
  "purpose": "Same fixed-replay protocol with bigram and trigram memory disabled.",
  "architecture_constants": {
    "position_encoding": "learned absolute",
    "normalization": "LayerNorm",
    "tied_embeddings": true,
    "dropout": 0.0,
    "backbone_optimizer": "AdamW",
    "backbone_betas": [
      0.8,
      0.95
    ],
    "data_mode": "fixed",
    "data_seed": 42
  },
  "measurement": {
    "gap": "fixed validation loss after update minus current online training batch loss before update",
    "same_logged_step": true,
    "validation_batches": "fixed at initialization"
  },
  "trainer_args": {
    "train_shards": "1",
    "val_shards": "2,3,4,5,6,7,8,9,10,6542",
    "seed": 42,
    "steps": 1000,
    "dtype": "bf16",
    "injection_position": "input",
    "inject_layers": "",
    "enable_unigram": 0,
    "enable_bigram": 0,
    "enable_trigram": 0,
    "bigram_clean_table": 0,
    "trigram_clean_table": 0,
    "bigram_table_dim": 0,
    "trigram_table_dim": 0,
    "bigram_perfect_map": "",
    "bigram_single_layer": false,
    "n_layer": 8,
    "n_head": 6,
    "n_embd": 768,
    "vocab_size": 8192,
    "sequence_len": 2048,
    "device_batch_size": 72,
    "total_batch_size": 147456,
    "lr": 0.0006,
    "weight_decay": 0.1,
    "lr_schedule": "warmup_constant",
    "lr_schedule_epochs": 0,
    "warmup_steps": 100,
    "warmup_start_lr_mult": 0.25,
    "table_optimizer": "rmsprop",
    "table_betas": "0.0,0.99",
    "table_lr_scale": 128.0,
    "val_interval": 10,
    "val_steps": "",
    "val_batches": 4,
    "freq_eval_interval": 10,
    "freq_eval_batches": 4,
    "exact_freq_eval_interval": 10,
    "table_norm_interval": 10,
    "table_diag": 0,
    "fixed_train_probe": 0,
    "train_probe_mode": "first",
    "probe_eval_interval": 10,
    "epoch_batches": 0,
    "replay_mix_passes": 0,
    "intervention": "none",
    "intervention_epochs": "",
    "context_eval_ab": 0,
    "compile": false,
    "logit_stats": false,
    "save_final_model": false,
    "save_epoch_checkpoints": false,
    "init_model": "",
    "freeze_table": false
  }
}
