# data directory (gitignored — large files, not tracked)
# 'data' (no slash) also matches the offload symlink (a symlink is not a dir)
data
# ...but keep docs/notes/data (cluster-infra coordinates, small markdown)
!docs/notes/data/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Training outputs (already covered by data/ but just in case)
runs/
*.log
# ...but keep task run logs, they are small and part of the evidence
!tasks/**/*.log
*.bin
*.pt
*.ckpt

# Plots (keep svg/html in docs/figs, ignore raw data dumps)
*.npz
.tmp_data/

# paper/ is a self-contained git clone of the Overleaf project
# (git.overleaf.com/6a9b071075d832e243e895a2); its git history is the
# versioning source. Lab-side paper tooling lives in scripts/ and
# docs/notes/method/paper-mirror.md (git cannot track files inside a
# nested repo). See docs/notes/method/paper-mirror.md.
paper/
output/
